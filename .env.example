# ==============================================================================
# SMART EXPENSE & OCR MANAGEMENT SYSTEM - ENVIRONMENT TEMPLATE
# ==============================================================================

PORT=5000

# 1. GOOGLE CLOUD VISION API KEY (Google OCR Engine)
GOOGLE_VISION_API_KEY=YOUR_GOOGLE_VISION_API_KEY_HERE
GOOGLE_API_KEY=YOUR_GOOGLE_VISION_API_KEY_HERE

# 2. GOOGLE SERVICE ACCOUNT (Google Drive & Google Sheets Integration)
# วาง JSON Content ของ Service Account ที่ดาวน์โหลดจาก Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"..."}

# Google Drive Parent Folder ID (โฟลเดอร์สำหรับเก็บภาพสลิปทั้งหมด)
GOOGLE_DRIVE_PARENT_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID_HERE

# Google Sheet Spreadsheet ID (ตารางสำหรับบันทึกรายการบัญชีรายรับ-รายจ่าย)
SPREADSHEET_ID=YOUR_GOOGLE_SPREADSHEET_ID_HERE

# 3. LINE OFFICIAL ACCOUNT & MESSAGING API
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN_HERE
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET_HERE

# 4. LINE FRONT-END FRAMEWORK (LIFF)
LIFF_ID=YOUR_LIFF_ID_HERE

# 5. PUBLIC APP URL (Tunnel / Domain)
PUBLIC_APP_URL=http://localhost:5000
